{
  "expo": {
    "name": "CYCLING",
    "slug": "cycling",
    "scheme": "cycling",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "cycling usa tu ubicaci\u00f3n para mostrarte en el mapa y registrar tus recorridos."
      }
    },
    "android": {
      "package": "com.cycling.app",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/02_APP_ASSETS/adaptive/adaptive-foreground-safe.png",
        "monochromeImage": "./assets/branding/02_APP_ASSETS/adaptive/adaptive-monochrome-safe.png",
        "backgroundColor": "#0F1210"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permitir que cycling acceda a tu ubicaci\u00f3n mientras utilizas la app.",
          "locationAlwaysAndWhenInUsePermission": "CYCLING usa tu ubicaci\u00f3n durante un recorrido activo, incluso con la pantalla bloqueada, para registrar tu trayecto hasta que pulses Finalizar.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true,
          "androidForegroundServiceIcon": "./assets/branding/02_APP_ASSETS/adaptive/adaptive-monochrome-safe.png"
        }
      ],
      "expo-secure-store",
      "expo-status-bar",
      "expo-font",
      "@maplibre/maplibre-react-native",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite seleccionar fotos y videos para tu perfil, tus ?lbumes y tus actividades de CYCLING.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/branding/03_SPLASH/native-splash-light.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-web-browser",
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0660f6d9-3724-45c0-82ef-c0887ec6f3e4"
      }
    },
    "icon": "./assets/branding/02_APP_ASSETS/icons/icon-1024.png"
  }
}
